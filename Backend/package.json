{
  "name": "sportify-campus-backend",
  "version": "1.0.0",
  "description": "Backend for SportifyCampus - College Sports Event Management System",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "cross-env NODE_ENV=test jest",
    "seed": "node scripts/seed-complete.js",
    "seed:reset": "node scripts/seed-complete.js"
  },
  "jest": {
    "testMatch": [
      "**/scripts/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/scripts/tests/setupTests.js"
    ]
  },
  "keywords": [
    "sports",
    "college",
    "tournament",
    "management",
    "mern",
    "backend",
    "api"
  ],
  "author": "Vikas Prasad",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "fs": "^0.0.1-security",
    "jest": "^30.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "next": "^15.5.4",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.8",
    "path": "^0.12.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "superjest": "^0.4.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}
